# Database Connection (SQLite local file or PostgreSQL connection string)
DATABASE_URL="file:./dev.db"

# JWT Secret for Admin Authentication
JWT_SECRET="replace-with-a-random-secure-64-character-string"

# Base Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Initial Super Admin Setup (Used during initial seeding)
INITIAL_ADMIN_EMAIL="admin@terracycles.com"
INITIAL_ADMIN_PASSWORD="ChangeThisPassword123!"
INITIAL_ADMIN_NAME="Chief Trail Officer"

# Optional SMTP Email Configuration (If not configured, inquiries are safely saved with status NOT_CONFIGURED)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="notifications@terracycles.com"
# SMTP_PASS="secret_password"
# SMTP_FROM="Terra Cycles <notifications@terracycles.com>"
